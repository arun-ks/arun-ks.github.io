---
import "../styles/global.css";
import "../styles/enhancements.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { capabilities, certifications, impact, portfolio, projects, roles, skillGroups } from "../data/site";
import posts from "../data/substack-posts.json";
import profileImage from "../assets/arun-k-sivanandan.jpg";
import sentientAuraLogo from "../assets/sentient-aura-logo.png";
import manitLogo from "../assets/manit-logo.png";
const base = import.meta.env.BASE_URL;
const localImages = import.meta.glob<{ default: ImageMetadata }>("../assets/**/*.{png,jpg,jpeg}", { eager: true });
const getLocalImage = (path: string) => {
  const image = localImages[`../assets/${path}`]?.default;
  if (!image) throw new Error(`Missing local image: ${path}`);
  return image;
};
const resumeUrl = `${base}Arun-K-Sivanandan-CV.pdf`;
const ogUrl = new URL(`${base}og.png`, Astro.site);
const canonicalUrl = new URL("/", Astro.site);
const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonicalUrl.href,
  name: "Arun K Sivanandan | CTO & Technology Leader | AI, Cloud & Telecom",
  mainEntity: {
    "@type": "Person",
    name: "Arun K Sivanandan",
    url: canonicalUrl.href,
    image: new URL(profileImage.src, Astro.site).href,
    email: "mailto:arun.k.s@hotmail.com",
    sameAs: [
      "https://www.linkedin.com/in/arunksivanandan/",
      "https://github.com/arun-ks",
      "https://arunk5.substack.com/",
    ],
  },
};
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || "https://cloud.umami.is/script.js";
const [featuredPost, ...secondaryPosts] = posts;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Technology leader with 28 years across AI, cloud, telecom delivery, solution architecture and engineering management." />
    <meta name="keywords" content="Arun K Sivanandan, Arun Sivanandan Malaysia, CTO Malaysia, technology leader Malaysia, AI leadership, cloud transformation, telecom technology leader, 5G delivery, solution architecture, engineering leadership, programme delivery, Amdocs, Openet, Sentient Aura" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#071116" />
    <meta property="og:title" content="Arun K Sivanandan | CTO & Technology Leader | AI, Cloud & Telecom" />
    <meta property="og:description" content="Technology leadership across AI, cloud transformation and telecom at scale." />
    <meta property="og:type" content="profile" /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={ogUrl} /><meta property="og:image:alt" content="Arun K Sivanandan — CTO and technology leader" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content="Arun K Sivanandan | CTO & Technology Leader | AI, Cloud & Telecom" />
    <meta name="twitter:description" content="Technology leadership across AI, cloud transformation and telecom at scale." /><meta name="twitter:image" content={ogUrl} />
    <link rel="canonical" href={canonicalUrl} /><link rel="icon" href={`${base}favicon.svg`} /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Arun K Sivanandan | CTO & Technology Leader | AI, Cloud & Telecom</title>
    <script type="application/ld+json" set:html={JSON.stringify(profileSchema)}></script>
    <script is:inline>(() => { const saved = localStorage.getItem("aks-theme"); const theme = saved || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark"); document.documentElement.dataset.theme = theme; })();</script>
    {umamiWebsiteId && <script is:inline defer src={umamiScriptUrl} data-website-id={umamiWebsiteId} data-domains="arun-ks.github.io" data-do-not-track="true" data-exclude-search="true"></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a><div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Arun K Sivanandan, home"><span>AKS</span><strong>Arun K Sivanandan</strong></a>
      <nav aria-label="Primary navigation"><a href="#about">About</a><a href="#journey">Journey</a><a href="#projects">Projects</a><a href="#portfolio">Portfolio</a><a href="#writing">Writing</a><a href="#contact">Contact</a></nav>
      <div class="header-actions"><button class="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch colour theme"><span class="sun">☀</span><span class="moon">◐</span></button><a class="resume-link" href={resumeUrl} target="_blank">Résumé ↗</a><button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">Menu</button></div>
    </header>
    <main id="main">
      <section class="hero section-shell">
        <div class="hero-copy reveal"><div class="status"><i></i> Technology leadership · Malaysia & global</div><p class="eyebrow">AI · CLOUD · TELECOM · DELIVERY</p><h1>Arun K<br/><span>Sivanandan.</span></h1><p class="hero-summary">I turn complex technology programmes into <strong>clear strategy, resilient teams and measurable delivery</strong>—from AI products and cloud transformation to telecom platforms serving millions.</p><div class="hero-meta"><span>⌖ Selangor, Malaysia</span><a href="mailto:arun.k.s@hotmail.com">✉ arun.k.s@hotmail.com</a></div><div class="hero-cta"><a class="button primary" href="#contact">Start a conversation <span>↗</span></a><a class="button secondary" href="#journey">Explore my journey</a><a class="icon-link" href="https://www.linkedin.com/in/arunksivanandan/" target="_blank" aria-label="LinkedIn profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.32 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.1 20.45H3.54V9H7.1v11.45Z"/></svg></a><a class="icon-link" href="https://github.com/arun-ks" target="_blank" aria-label="GitHub profile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.82 1.19 3.08 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.07.79 2.16v3.02c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg></a></div></div>
        <div class="hero-system"><div class="orbit orbit-a" aria-hidden="true"></div><div class="orbit orbit-b" aria-hidden="true"></div><div class="orbit orbit-c" aria-hidden="true"></div><div class="portrait-frame"><Image src={profileImage} alt="Arun K Sivanandan" widths={[320, 480, 600]} sizes="(max-width: 900px) 45vw, 320px" priority /></div><a class="focus-card" href="https://www.thesentientaura.com/" target="_blank"><Image src={sentientAuraLogo} alt="Sentient Aura" width={72} height={72} priority /><span><small>CURRENT FOCUS</small><strong>AI-powered human wellbeing</strong><em>CTO · Sentient Aura ↗</em></span></a><span class="node n1" aria-hidden="true">AI</span><span class="node n2" aria-hidden="true">5G</span><span class="node n3" aria-hidden="true">CLOUD</span><span class="node n4" aria-hidden="true">TEAMS</span></div>
      </section>
      <section class="impact-strip section-shell" aria-label="Career highlights">{impact.map((item) => <div class="impact-item reveal"><strong>{item.value}<em>{item.suffix}</em></strong><span>{item.label}</span></div>)}</section>
      <section class="content-section section-shell" id="about"><div class="section-heading reveal"><p>01 — About</p><h2>Technology with purpose.<br/><span>Leadership with evidence.</span></h2></div><div class="about-grid"><div class="about-copy reveal"><p class="lead">For nearly three decades, I have worked where strategy, architecture and delivery meet—helping organisations modernise critical platforms while keeping people, customers and outcomes in focus.</p><p>My career spans hands-on engineering, solution architecture, engineering management and large-scale programme leadership across telecom, media, banking and AI-enabled wellbeing. I am most useful when the problem is complex, the stakeholder map is crowded and a team needs clarity to move.</p><a class="text-link" href={resumeUrl} target="_blank">Read the complete résumé <span>↗</span></a></div><div class="capability-grid">{capabilities.map((item, i) => <article class="capability reveal"><span>0{i + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div><div class="marquee" aria-label="Core expertise"><div>{["Technology Strategy", "Generative AI", "Cloud Transformation", "Engineering Leadership", "5G & Telecom", "Programme Delivery", "Solution Architecture", "Responsible AI", "Technology Strategy", "Generative AI"].map((item) => <span>{item}</span>)}</div></div></section>
      <section class="content-section journey section-shell" id="journey"><div class="section-heading reveal"><p>02 — Career Journey</p><h2>From engineering foundations<br/><span>to technology leadership.</span></h2></div><div class="timeline">{roles.map((role, i) => <article class="role reveal"><div class="role-marker"><span>{String(i + 1).padStart(2, "0")}</span></div><div class="role-meta"><p>{role.period}</p><span>{role.location}</span></div><div class="role-body"><div class="role-title"><div class="company-heading"><a class="company-logo" href={role.companyUrl} target="_blank" aria-label={`Visit ${role.company}`}><Image src={getLocalImage(role.logo)} alt="" width={96} loading="lazy" /></a><div><h3><a href={role.companyUrl} target="_blank">{role.company} <span>↗</span></a></h3><h4>{role.title}</h4></div></div><button class="role-toggle" type="button" aria-expanded="false" aria-label={`Show full details for ${role.company}`}>+</button></div><p class="role-summary">{role.summary}</p><div class="role-details"><div class="role-details-inner"><p class="details-label">Full role details</p><ul>{role.bullets.map((bullet) => <li>{bullet}</li>)}</ul><div class="tags">{role.tags.map((tag) => <span>{tag}</span>)}</div></div></div></div></article>)}</div></section>
      <section class="content-section section-shell" id="projects"><div class="section-heading reveal"><p>03 — Selected Impact</p><h2>Complex programmes.<br/><span>Concrete outcomes.</span></h2></div><div class="project-grid">{projects.map((project) => <article class="project-card reveal"><div class="project-top"><span>{project.kicker}</span><strong>{project.stat}</strong></div><div class="project-heading"><div class:list={["project-visual", { "project-visual-rag": project.visual === "rag" }]}>{project.visual === "rag" ? <span aria-label={project.visualAlt}>AI<small>RAG</small></span> : project.imageHref ? <a href={project.imageHref} target="_blank"><Image src={getLocalImage(project.image)} alt={project.imageAlt} width={160} loading="lazy" /></a> : <Image src={getLocalImage(project.image)} alt={project.imageAlt} width={160} loading="lazy" />}</div><div><h3>{project.title}</h3><p>{project.text}</p></div><button class="project-toggle" type="button" aria-expanded="false" aria-label={`Show full project details for ${project.title}`}><span class="project-toggle-label">View details</span><span class="project-toggle-icon" aria-hidden="true">+</span></button></div><div class="project-details"><div class="project-details-inner"><p class="details-label">Full project story</p><ul>{project.details.map((detail) => <li>{detail}</li>)}</ul></div></div></article>)}</div></section>
      <section class="content-section section-shell" id="portfolio"><div class="section-heading split reveal"><div><p>04 — Portfolio</p><h2>Selected things<br/><span>I have built.</span></h2></div><a class="text-link" href="https://github.com/arun-ks?tab=repositories" target="_blank">All repositories <span>↗</span></a></div><div class="portfolio-grid">{portfolio.map((item) => { const primaryHref = item.live || item.href; const destination = item.live ? "live project" : "GitHub repository"; return <article class="portfolio-card reveal"><div class="portfolio-card-top"><div class="portfolio-identity"><a class="portfolio-visual portfolio-primary-link" href={primaryHref} target="_blank" aria-label={`Open ${item.name} ${destination}`}><Image src={getLocalImage(item.image)} alt="" width={384} height={384} loading="lazy" /></a><h3><a class="portfolio-title-link" href={primaryHref} target="_blank">{item.name}</a></h3></div><p>{item.language}</p></div><div class="portfolio-body"><span>{item.description}</span><div>{item.live && <a class="portfolio-live" href={item.live} target="_blank">Live ↗</a>}<a href={item.href} target="_blank">GitHub ↗</a></div></div></article>; })}</div></section>
      <section class="content-section writing section-shell" id="writing"><div class="section-heading split reveal"><div><p>05 — Writing</p><h2>Notes on technology,<br/><span>work and people.</span></h2></div><a class="text-link" href="https://arunk5.substack.com/" target="_blank">Visit Substack <span>↗</span></a></div>{featuredPost && <div class="writing-layout"><a class="featured-post reveal" href={featuredPost.href} target="_blank"><div class:list={["writing-image", { "no-image": !featuredPost.image }]}>{featuredPost.image ? <img src={featuredPost.image} alt="" loading="lazy" decoding="async" /> : <span>AKS</span>}</div><div class="featured-post-copy"><p>Latest article</p><h3>{featuredPost.title}</h3><span>{featuredPost.excerpt}</span><b>Read on Substack ↗</b></div></a><div class="secondary-posts">{secondaryPosts.map((post) => <a class="secondary-post reveal" href={post.href} target="_blank"><div class:list={["secondary-post-image", { "no-image": !post.image }]}>{post.image ? <img src={post.image} alt="" loading="lazy" decoding="async" /> : <span>AKS</span>}</div><div><h3>{post.title}</h3><span>{post.excerpt}</span></div><b>↗</b></a>)}</div></div>}</section>
      <section class="content-section section-shell credentials" id="credentials"><div class="section-heading reveal"><p>06 — Credentials & Toolkit</p><h2>Always learning.<br/><span>Still hands-on.</span></h2></div><div class="credentials-grid"><div class="education-card reveal"><div class="education-label"><p>Education</p><a href="https://www.manit.ac.in/" target="_blank" aria-label="Visit Maulana Azad National Institute of Technology"><Image src={manitLogo} alt="Maulana Azad National Institute of Technology logo" width={87} height={101} loading="lazy" /></a></div><h3>Bachelor of Engineering (Honours)</h3><span>Computer Science & Engineering</span><strong>Maulana Azad National Institute of Technology</strong><small>1994 — 1998 · Bhopal, India</small></div><div class="cert-card reveal"><p>Selected certifications</p><ul>{certifications.map((cert) => <li><a href={cert.href} target="_blank"><span>{cert.name}</span><b>↗</b></a></li>)}</ul><a href="https://arun-ks.github.io/cert/" target="_blank">View certificate catalogue ↗</a></div></div><div class="skill-grid">{skillGroups.map((group) => <div class="skill-group reveal"><h3>{group.name}</h3><p>{group.items}</p></div>)}</div></section>
      <section class="contact section-shell" id="contact"><div class="contact-inner reveal"><p>07 — Contact</p><h2>Let’s make complexity<br/><span>move forward.</span></h2><p class="contact-copy">Open to technology leadership, advisory and conversations about AI, cloud transformation, telecom and building high-performing teams.</p><a class="contact-email" href="mailto:arun.k.s@hotmail.com">arun.k.s@hotmail.com <span>↗</span></a><div class="contact-links"><a href="https://www.linkedin.com/in/arunksivanandan/" target="_blank">LinkedIn ↗</a><a href="https://github.com/arun-ks" target="_blank">GitHub ↗</a><a href="https://arunk5.substack.com/" target="_blank">Substack ↗</a><a href={resumeUrl} target="_blank">Résumé ↗</a></div></div></section>
    </main>
    <footer class="section-shell"><a class="brand" href="#top"><span>AKS</span><strong>Arun K Sivanandan</strong></a><p>Technology leadership · AI · Cloud · Telecom</p><span>© 2026 Arun K Sivanandan</span></footer>
    <script>
      const root = document.documentElement; const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const syncThemeLabel = () => { if (toggle) toggle.setAttribute("aria-label", `Switch to ${root.dataset.theme === "dark" ? "light" : "dark"} mode`); }; syncThemeLabel();
      toggle?.addEventListener("click", () => { root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark"; localStorage.setItem("aks-theme", root.dataset.theme); syncThemeLabel(); });
      const menu = document.querySelector<HTMLButtonElement>(".menu-toggle"); const nav = document.querySelector<HTMLElement>(".site-header nav");
      menu?.addEventListener("click", () => { const open = menu.getAttribute("aria-expanded") === "true"; menu.setAttribute("aria-expanded", String(!open)); nav?.classList.toggle("open", !open); });
      nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { nav.classList.remove("open"); menu?.setAttribute("aria-expanded", "false"); }));
      document.querySelectorAll<HTMLButtonElement>(".role-toggle").forEach((button) => button.addEventListener("click", () => { const details = button.closest(".role-body")?.querySelector(".role-details"); const open = details?.classList.toggle("open") ?? false; const company = button.closest(".role-body")?.querySelector("h3")?.textContent || "this role"; button.textContent = open ? "−" : "+"; button.setAttribute("aria-expanded", String(open)); button.setAttribute("aria-label", `${open ? "Hide" : "Show"} full details for ${company}`); }));
      document.querySelectorAll<HTMLButtonElement>(".project-toggle").forEach((button) => button.addEventListener("click", () => { const card = button.closest(".project-card"); const details = card?.querySelector(".project-details"); const open = details?.classList.toggle("open") ?? false; const project = card?.querySelector("h3")?.textContent || "this project"; const label = button.querySelector<HTMLElement>(".project-toggle-label"); const icon = button.querySelector<HTMLElement>(".project-toggle-icon"); if (label) label.textContent = open ? "Hide details" : "View details"; if (icon) icon.textContent = open ? "−" : "+"; button.setAttribute("aria-expanded", String(open)); button.setAttribute("aria-label", `${open ? "Hide" : "Show"} full project details for ${project}`); }));
      document.addEventListener("click", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>("a[href]"); if (!link) return;
        const analytics = (window as Window & { umami?: { track: (name: string, data?: Record<string, string>) => void } }).umami;
        if (!analytics) return;
        const portfolioCard = link.closest<HTMLElement>(".portfolio-card");
        let eventName = ""; let label = link.textContent?.trim() || "";
        if (portfolioCard) { eventName = link.hostname === "github.com" ? "portfolio_repository_open" : "portfolio_live_open"; label = portfolioCard.querySelector("h3")?.textContent?.trim() || label; }
        else if (link.pathname.endsWith("Arun-K-Sivanandan-CV.pdf")) eventName = "resume_download";
        else if (link.protocol === "mailto:") eventName = "contact_email_click";
        else if (link.hostname === "arun-ks.github.io" && link.pathname.startsWith("/cert")) eventName = "certificate_catalogue_open";
        else if (link.hostname === "arunk5.substack.com" && link.pathname.startsWith("/p/")) eventName = "substack_article_open";
        else if (link.hostname === "github.com" && link.pathname.replace(/\/$/, "") === "/arun-ks") eventName = "github_profile_open";
        if (eventName) analytics.track(eventName, label ? { label } : undefined);
      });
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("visible")), { threshold: .08 }); document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
