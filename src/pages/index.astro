---
import "../styles/global.css";
import "../styles/enhancements.css";
import { capabilities, certifications, impact, portfolio, projects, roles, skillGroups } from "../data/site";
import posts from "../data/substack-posts.json";
const base = import.meta.env.BASE_URL;
const resumeUrl = `${base}Arun-K-Sivanandan-CV.pdf`;
const ogUrl = new URL(`${base}og.png`, Astro.site);
const [featuredPost, ...secondaryPosts] = posts;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Technology leader with 28 years across AI, cloud, telecom delivery, solution architecture and engineering management." />
    <meta name="theme-color" content="#071116" />
    <meta property="og:title" content="Arun K Sivanandan — Technology Leader" />
    <meta property="og:description" content="Technology leadership across AI, cloud transformation and telecom at scale." />
    <meta property="og:type" content="website" /><meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content="Arun K Sivanandan — Technology Leader" />
    <meta name="twitter:description" content="Technology leadership across AI, cloud transformation and telecom at scale." /><meta name="twitter:image" content={ogUrl} />
    <link rel="icon" href={`${base}favicon.svg`} /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Arun K Sivanandan — Technology Leader</title>
    <script is:inline>(() => { const saved = localStorage.getItem("aks-theme"); const theme = saved || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark"); document.documentElement.dataset.theme = theme; })();</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a><div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Arun K Sivanandan, home"><span>AKS</span><strong>Arun K Sivanandan</strong></a>
      <nav aria-label="Primary navigation"><a href="#about">About</a><a href="#journey">Journey</a><a href="#projects">Projects</a><a href="#portfolio">Portfolio</a><a href="#writing">Writing</a><a href="#contact">Contact</a></nav>
      <div class="header-actions"><button class="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch colour theme"><span class="sun">☀</span><span class="moon">◐</span></button><a class="resume-link" href={resumeUrl} target="_blank">Résumé ↗</a><button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">Menu</button></div>
    </header>
    <main id="main">
      <section class="hero section-shell">
        <div class="hero-copy reveal"><div class="status"><i></i> Technology leadership · Malaysia & global</div><p class="eyebrow">AI · CLOUD · TELECOM · DELIVERY</p><h1>Arun K<br/><span>Sivanandan.</span></h1><p class="hero-summary">I turn complex technology programmes into <strong>clear strategy, resilient teams and measurable delivery</strong>—from AI products and cloud transformation to telecom platforms serving millions.</p><div class="hero-meta"><span>⌖ Selangor, Malaysia</span><a href="mailto:arun.k.s@hotmail.com">✉ arun.k.s@hotmail.com</a></div><div class="hero-cta"><a class="button primary" href="#contact">Start a conversation <span>↗</span></a><a class="button secondary" href="#journey">Explore my journey</a><a class="icon-link" href="https://www.linkedin.com/in/arunksivanandan/" target="_blank" aria-label="LinkedIn profile">in</a><a class="icon-link" href="https://github.com/arun-ks" target="_blank" aria-label="GitHub profile">gh</a></div></div>
        <div class="hero-system"><div class="orbit orbit-a" aria-hidden="true"></div><div class="orbit orbit-b" aria-hidden="true"></div><div class="orbit orbit-c" aria-hidden="true"></div><div class="portrait-frame"><img src={`${base}arun-k-sivanandan.jpg`} alt="Arun K Sivanandan" /></div><a class="focus-card" href="https://www.thesentientaura.com/" target="_blank"><img src={`${base}sentient-aura-logo.png`} alt="Sentient Aura" /><span><small>CURRENT FOCUS</small><strong>AI-powered human wellbeing</strong><em>CTO · Sentient Aura ↗</em></span></a><span class="node n1" aria-hidden="true">AI</span><span class="node n2" aria-hidden="true">5G</span><span class="node n3" aria-hidden="true">CLOUD</span><span class="node n4" aria-hidden="true">TEAMS</span></div>
      </section>
      <section class="impact-strip section-shell" aria-label="Career highlights">{impact.map((item) => <div class="impact-item reveal"><strong>{item.value}<em>{item.suffix}</em></strong><span>{item.label}</span></div>)}</section>
      <section class="content-section section-shell" id="about"><div class="section-heading reveal"><p>01 — About</p><h2>Technology with purpose.<br/><span>Leadership with evidence.</span></h2></div><div class="about-grid"><div class="about-copy reveal"><p class="lead">For nearly three decades, I have worked where strategy, architecture and delivery meet—helping organisations modernise critical platforms while keeping people, customers and outcomes in focus.</p><p>My career spans hands-on engineering, solution architecture, engineering management and large-scale programme leadership across telecom, media, banking and AI-enabled wellbeing. I am most useful when the problem is complex, the stakeholder map is crowded and a team needs clarity to move.</p><a class="text-link" href={resumeUrl} target="_blank">Read the complete résumé <span>↗</span></a></div><div class="capability-grid">{capabilities.map((item, i) => <article class="capability reveal"><span>0{i + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div><div class="marquee" aria-label="Core expertise"><div>{["Technology Strategy", "Generative AI", "Cloud Transformation", "Engineering Leadership", "5G & Telecom", "Programme Delivery", "Solution Architecture", "Responsible AI", "Technology Strategy", "Generative AI"].map((item) => <span>{item}</span>)}</div></div></section>
      <section class="content-section journey section-shell" id="journey"><div class="section-heading reveal"><p>02 — Career Journey</p><h2>From engineering foundations<br/><span>to technology leadership.</span></h2></div><div class="timeline">{roles.map((role, i) => <article class="role reveal"><div class="role-marker"><span>{String(i + 1).padStart(2, "0")}</span></div><div class="role-meta"><p>{role.period}</p><span>{role.location}</span></div><div class="role-body"><div class="role-title"><div class="company-heading"><a class="company-logo" href={role.companyUrl} target="_blank" aria-label={`Visit ${role.company}`}><img src={`${base}${role.logo}`} alt="" /></a><div><h3><a href={role.companyUrl} target="_blank">{role.company} <span>↗</span></a></h3><h4>{role.title}</h4></div></div><button class="role-toggle" type="button" aria-expanded="false" aria-label={`Show full details for ${role.company}`}>+</button></div><p class="role-summary">{role.summary}</p><div class="role-details"><div class="role-details-inner"><p class="details-label">Full role details</p><ul>{role.bullets.map((bullet) => <li>{bullet}</li>)}</ul><div class="tags">{role.tags.map((tag) => <span>{tag}</span>)}</div></div></div></div></article>)}</div></section>
      <section class="content-section section-shell" id="projects"><div class="section-heading reveal"><p>03 — Selected Impact</p><h2>Complex programmes.<br/><span>Concrete outcomes.</span></h2></div><div class="project-grid">{projects.map((project) => <article class="project-card reveal"><div class="project-top"><span>{project.kicker}</span><strong>{project.stat}</strong></div><div class="project-heading"><div class:list={["project-visual", { "project-visual-rag": project.visual === "rag" }]}>{project.visual === "rag" ? <span aria-label={project.visualAlt}>AI<small>RAG</small></span> : project.imageHref ? <a href={project.imageHref} target="_blank"><img src={`${base}${project.image}`} alt={project.imageAlt} loading="lazy" /></a> : <img src={`${base}${project.image}`} alt={project.imageAlt} loading="lazy" />}</div><div><h3>{project.title}</h3><p>{project.text}</p></div><button class="project-toggle" type="button" aria-expanded="false" aria-label={`Show full project details for ${project.title}`}>+</button></div><div class="project-details"><div class="project-details-inner"><p class="details-label">Full project story</p><ul>{project.details.map((detail) => <li>{detail}</li>)}</ul></div></div></article>)}</div></section>
      <section class="content-section section-shell" id="portfolio"><div class="section-heading split reveal"><div><p>04 — Portfolio</p><h2>Selected things<br/><span>I have built.</span></h2></div><a class="text-link" href="https://github.com/arun-ks?tab=repositories" target="_blank">All repositories <span>↗</span></a></div><div class="portfolio-grid">{portfolio.map((item) => { const primaryHref = item.live || item.href; const destination = item.live ? "live project" : "GitHub repository"; return <article class="portfolio-card reveal"><div class="portfolio-card-top"><div class="portfolio-identity"><a class="portfolio-visual portfolio-primary-link" href={primaryHref} target="_blank" aria-label={`Open ${item.name} ${destination}`}><img src={`${base}${item.image}`} alt="" loading="lazy" /></a><h3><a class="portfolio-title-link" href={primaryHref} target="_blank">{item.name}</a></h3></div><p>{item.language}</p></div><div class="portfolio-body"><span>{item.description}</span><div>{item.live && <a class="portfolio-live" href={item.live} target="_blank">Live ↗</a>}<a href={item.href} target="_blank">GitHub ↗</a></div></div></article>; })}</div></section>
      <section class="content-section writing section-shell" id="writing"><div class="section-heading split reveal"><div><p>05 — Writing</p><h2>Notes on technology,<br/><span>work and people.</span></h2></div><a class="text-link" href="https://arunk5.substack.com/" target="_blank">Visit Substack <span>↗</span></a></div>{featuredPost && <div class="writing-layout"><a class="featured-post reveal" href={featuredPost.href} target="_blank"><div class:list={["writing-image", { "no-image": !featuredPost.image }]}>{featuredPost.image ? <img src={featuredPost.image} alt="" /> : <span>AKS</span>}</div><div class="featured-post-copy"><p>Latest article</p><h3>{featuredPost.title}</h3><span>{featuredPost.excerpt}</span><b>Read on Substack ↗</b></div></a><div class="secondary-posts">{secondaryPosts.map((post) => <a class="secondary-post reveal" href={post.href} target="_blank"><div class:list={["secondary-post-image", { "no-image": !post.image }]}>{post.image ? <img src={post.image} alt="" loading="lazy" /> : <span>AKS</span>}</div><div><h3>{post.title}</h3><span>{post.excerpt}</span></div><b>↗</b></a>)}</div></div>}</section>
      <section class="content-section section-shell credentials" id="credentials"><div class="section-heading reveal"><p>06 — Credentials & Toolkit</p><h2>Always learning.<br/><span>Still hands-on.</span></h2></div><div class="credentials-grid"><div class="education-card reveal"><div class="education-label"><p>Education</p><a href="https://www.manit.ac.in/" target="_blank" aria-label="Visit Maulana Azad National Institute of Technology"><img src={`${base}manit-logo.png`} alt="Maulana Azad National Institute of Technology logo" /></a></div><h3>Bachelor of Engineering (Honours)</h3><span>Computer Science & Engineering</span><strong>Maulana Azad National Institute of Technology</strong><small>1994 — 1998 · Bhopal, India</small></div><div class="cert-card reveal"><p>Selected certifications</p><ul>{certifications.map((cert) => <li><a href={cert.href} target="_blank"><span>{cert.name}</span><b>↗</b></a></li>)}</ul><a href="https://arun-ks.github.io/cert/" target="_blank">View certificate catalogue ↗</a></div></div><div class="skill-grid">{skillGroups.map((group) => <div class="skill-group reveal"><h3>{group.name}</h3><p>{group.items}</p></div>)}</div></section>
      <section class="contact section-shell" id="contact"><div class="contact-inner reveal"><p>07 — Contact</p><h2>Let’s make complexity<br/><span>move forward.</span></h2><p class="contact-copy">Open to technology leadership, advisory and conversations about AI, cloud transformation, telecom and building high-performing teams.</p><a class="contact-email" href="mailto:arun.k.s@hotmail.com">arun.k.s@hotmail.com <span>↗</span></a><div class="contact-links"><a href="https://www.linkedin.com/in/arunksivanandan/" target="_blank">LinkedIn ↗</a><a href="https://github.com/arun-ks" target="_blank">GitHub ↗</a><a href="https://arunk5.substack.com/" target="_blank">Substack ↗</a><a href={resumeUrl} target="_blank">Résumé ↗</a></div></div></section>
    </main>
    <footer class="section-shell"><a class="brand" href="#top"><span>AKS</span><strong>Arun K Sivanandan</strong></a><p>Technology leadership · AI · Cloud · Telecom</p><span>© 2026 Arun K Sivanandan</span></footer>
    <script>
      const root = document.documentElement; const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const syncThemeLabel = () => { if (toggle) toggle.setAttribute("aria-label", `Switch to ${root.dataset.theme === "dark" ? "light" : "dark"} mode`); }; syncThemeLabel();
      toggle?.addEventListener("click", () => { root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark"; localStorage.setItem("aks-theme", root.dataset.theme); syncThemeLabel(); });
      const menu = document.querySelector<HTMLButtonElement>(".menu-toggle"); const nav = document.querySelector<HTMLElement>(".site-header nav");
      menu?.addEventListener("click", () => { const open = menu.getAttribute("aria-expanded") === "true"; menu.setAttribute("aria-expanded", String(!open)); nav?.classList.toggle("open", !open); });
      nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { nav.classList.remove("open"); menu?.setAttribute("aria-expanded", "false"); }));
      document.querySelectorAll<HTMLButtonElement>(".role-toggle").forEach((button) => button.addEventListener("click", () => { const details = button.closest(".role-body")?.querySelector(".role-details"); const open = details?.classList.toggle("open") ?? false; const company = button.closest(".role-body")?.querySelector("h3")?.textContent || "this role"; button.textContent = open ? "−" : "+"; button.setAttribute("aria-expanded", String(open)); button.setAttribute("aria-label", `${open ? "Hide" : "Show"} full details for ${company}`); }));
      document.querySelectorAll<HTMLButtonElement>(".project-toggle").forEach((button) => button.addEventListener("click", () => { const card = button.closest(".project-card"); const details = card?.querySelector(".project-details"); const open = details?.classList.toggle("open") ?? false; const project = card?.querySelector("h3")?.textContent || "this project"; button.textContent = open ? "−" : "+"; button.setAttribute("aria-expanded", String(open)); button.setAttribute("aria-label", `${open ? "Hide" : "Show"} full project details for ${project}`); }));
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("visible")), { threshold: .08 }); document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
